# Optional integrations. The app runs without secrets in sample/basic mode.
# Copy to .env.local; never commit real keys.

# Conversational AI. Server-side only. Without a key, basic preference parsing works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Per-process daily public AI request cap; rate limits are also applied per client.
AI_DAILY_REQUEST_LIMIT=100

# Hotel inventory. Without credentials, all hotels and prices are labeled samples.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test or production. Test credentials return sandbox inventory.
AMADEUS_ENV=test

# Optional inherited Discord authentication endpoint (not used for browser storage).
# Set all three to enable OAuth. Generate AUTH_SECRET with openssl rand -base64 32.
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
