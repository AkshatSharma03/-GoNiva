# Optional integrations. The app runs without secrets in sample/basic mode.
# Copy to .env.local; never commit real keys.

# Conversational AI. Server-side only. Without a key, basic preference parsing works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Per-process daily public AI request cap; rate limits are also applied per client.
AI_DAILY_REQUEST_LIMIT=100

# Nuitee/LiteAPI: get your own key at https://connect.nuitee.com (Developer tools > API Keys).
# Server-only. An empty key enables labeled sample hotels.
LITEAPI_API_KEY=
# sandbox for sand_ keys; production for prod_ keys. Never mix environments.
LITEAPI_ENV=sandbox

# Optional inherited Discord authentication endpoint (not used for browser storage).
# Set all three to enable OAuth. Generate AUTH_SECRET with openssl rand -base64 32.
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
